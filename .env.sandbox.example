# Copy to .env.sandbox and fill with sandbox/test-only values.
# Never copy values from .env or .env.local into this file.

CODEX_PROJECT_SANDBOX=1
ALLOW_SANDBOX_DB=1
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Use local or test resources only.
MONGODB_URI=mongodb://127.0.0.1:27017/unicodesnwrites-sandbox
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-local-random-secret
ADMIN_EMAIL=sandbox-admin@example.test
ADMIN_PASSWORD=sandbox-admin-password-123

# Use test-mode provider keys only.
# Razorpay test mode (Dashboard -> Test Mode -> Account & Settings -> API keys).
# Only RAZORPAY_KEY_ID is sent to the browser; the secrets stay server-side.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret
# Secret you type when adding the test-mode webhook (Account & Settings -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=replace-with-local-random-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_test_or_sandbox_token

# Grounded AI notes provider (Groq Cloud).
GROQ_API_KEY=replace-with-sandbox-groq-key
GROQ_MODEL=openai/gpt-oss-20b
AI_NOTES_DAILY_LIMIT=250
AI_NOTES_DAILY_PER_IP_LIMIT=12

# Optional: route YouTube caption requests through an HTTP(S) proxy.
# YouTube blocks most cloud IPs (e.g. Vercel), so set this on hosted
# deployments. Leave empty locally. Format: http://user:pass@host:port
YOUTUBE_PROXY_URL=

# Gmail SMTP via Nodemailer. Use a sandbox Gmail account and an app password,
# not your normal Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-sandbox-gmail-address@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-sandbox-gmail-address@gmail.com
EMAIL_FROM_NAME=Unicode & Writes

# Newsletter delivery. Public base URL used in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HMAC secret for unsubscribe links. Changing it invalidates links in already-sent emails.
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-local-random-secret
# Scheduler auth: Vercel Cron sends "Authorization: Bearer $CRON_SECRET";
# external cron services can send "x-scheduler-secret: $NEWSLETTER_SCHEDULER_SECRET".
CRON_SECRET=replace-with-local-random-secret
NEWSLETTER_SCHEDULER_SECRET=replace-with-local-random-secret
# Physical mailing address shown in the newsletter footer (required by CAN-SPAM for commercial email).
NEWSLETTER_POSTAL_ADDRESS=

# Business shown on legal pages, footer and Razorpay checkout. unicodesnwrites is a
# Lagnever product, so these must match the Lagnever Razorpay merchant account.
# BUSINESS_POSTAL_ADDRESS falls back to NEWSLETTER_POSTAL_ADDRESS when empty.
# Defaults (lib/config/business.ts) are Lagnever's published details; set only to override.
BUSINESS_LEGAL_NAME=LAGNEVER (proprietor: Shakeela Begum)
BUSINESS_SUPPORT_EMAIL=support@lagnevertech.com
BUSINESS_SUPPORT_PHONE=+91 96226 85834
BUSINESS_POSTAL_ADDRESS=Rajouri, Jammu & Kashmir, India
