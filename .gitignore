# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.agent-context/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.sandbox.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private email uploads
/emails.txt
/RUNTIME_SANDBOX.md
/test-results/

# Never publish: paid product files, internal docs, scratch output
/private-uploads/
/docs/security/
/docs/design/
/DESIGN_CONTEXT.md
/CONTEXT.md
/debug-output.txt
/scratch.*
/.agents/
*.zip
*.pem
*.key
*.p12

# self-hosted course videos (uploaded separately, too large for git)
/public/course-media/
# free course downloads are shipped as zips on purpose
!/public/courses/**/*.zip
